# Base de datos (Upstash Redis vía Vercel Marketplace la inyecta sola en Vercel;
# en local copia el valor desde `vercel env pull`)
REDIS_URL=
MC_API_KEY=
ANTHROPIC_API_KEY=

# Briefing rate limit (opcionales — defaults: 300 / 600 / 5)
BRIEFING_DAILY_COOLDOWN_SECONDS=
BRIEFING_PROJECT_COOLDOWN_SECONDS=
BRIEFING_MONTHLY_CAP_USD=

# Cron diario (keepalive + backup) — ver SETUP.md, sección "Copias de seguridad"
CRON_SECRET=
BACKUP_REPO=
BACKUP_GITHUB_TOKEN=
